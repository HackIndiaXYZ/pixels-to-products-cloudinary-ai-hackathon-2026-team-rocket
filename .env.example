# VisualOps — environment configuration
# Copy to .env.local (never commit it) and fill in your own values.
# Without any of these, VisualOps runs read-only on Cloudinary's public "demo" cloud.

# ---------------------------------------------------------------------------
# Server (Next.js route handlers). Required for uploads and for reading your
# records back from Cloudinary. Never prefix these with NEXT_PUBLIC_: the API
# secret must stay on the server.
# ---------------------------------------------------------------------------

# Cloudinary Console → Settings → API Keys (product environment credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Signed upload preset used for every upload (Settings → Upload → Upload presets).
CLOUDINARY_UPLOAD_PRESET=visualops_uploads

# Optional. Tag that marks VisualOps records in your cloud (default: visualops).
VISUALOPS_TAG=visualops

# ---------------------------------------------------------------------------
# Browser (optional). Public values only, used when no server credentials are
# set (for example a static deployment): Sync reads the client-side resource
# list, and uploads need an UNSIGNED preset.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
NEXT_PUBLIC_VISUALOPS_TAG=visualops
