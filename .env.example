# VisualOps — Cloudinary configuration
# Copy to .env.local and fill in your own values. Never commit .env.local.
#
# VisualOps only needs PUBLIC values. It never uses a Cloudinary API key or
# API secret: uploads go through an *unsigned* upload preset.
# Without any of these, the app runs on Cloudinary's public "demo" cloud.

# Your Cloudinary cloud name (Console → Dashboard → Product environment).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name

# An UNSIGNED upload preset (Console → Settings → Upload → Upload presets →
# Add upload preset → Signing mode: Unsigned). Enables uploads from the console.
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# Optional. Tag added to every upload and read back by "Sync from Cloudinary".
NEXT_PUBLIC_VISUALOPS_TAG=visualops
